<%- include('partials/header', { title: 'Пользователи' }) %>

<div class="card">
  <form method="get" action="/admin/users" class="form-row">
    <div class="form-group" style="flex:1">
      <input class="form-input" name="q" value="<%= q %>" placeholder="Поиск по логину или имени..." />
    </div>
    <button type="submit" class="btn btn-primary" style="height:38px;">Найти</button>
  </form>
</div>

<div class="stats-grid">
  <div class="stat-card">
    <div class="stat-label">Всего</div>
    <div class="stat-value accent"><%= memoryTotals.users %></div>
    <div class="stat-sub">пользователей</div>
  </div>
  <div class="stat-card">
    <div class="stat-label">С профилем памяти</div>
    <div class="stat-value success"><%= memoryTotals.withProfile %></div>
    <div class="stat-sub">нейросеть составила досье</div>
  </div>
  <div class="stat-card">
    <div class="stat-label">Сводки сессий</div>
    <div class="stat-value"><%= memoryTotals.summaries %></div>
    <div class="stat-sub">сохранено</div>
  </div>
  <div class="stat-card">
    <div class="stat-label">Факты о юзерах</div>
    <div class="stat-value"><%= memoryTotals.facts %></div>
    <div class="stat-sub">запомнено</div>
  </div>
</div>
<div class="card">
  <h2 class="card-title">Список пользователей</h2>
  <div class="table-wrapper">
    <table>
      <thead><tr>
        <th>Логин</th>
        <th>Имя</th>
        <th>Роль</th>
        <th>Блок</th>
        <th>Память</th>
        <th>Создан</th>
      </tr></thead>
      <tbody>
      <% users.forEach((u) => { %>
        <tr>
          <td><a href="/admin/users/<%= u.id %>" class="table-link"><%= u.username %></a></td>
          <td><%= u.displayName %></td>
          <td><span class="badge badge-muted"><%= u.role %></span></td>
          <td>
            <% if (u.isDeleted) { %>
              <span class="badge badge-warning">Удалён</span>
              <div style="font-size:11px; color:var(--text-faint); margin-top:4px;">
                <%= u.deletedAt ? u.deletedAt.toISOString().slice(0,16).replace('T', ' ') : '—' %>
              </div>
            <% } else if(u.isBlocked) { %>
              <span class="badge badge-danger">Заблокирован</span>
            <% } else { %>
              <span class="badge badge-success">Активен</span>
            <% } %>
          </td>
          <td>
            <div style="font-size:12px">Профиль: <span class="<%= u.memoryStats.hasProfile ? 'badge badge-success' : 'badge badge-muted' %>"><%= u.memoryStats.hasProfile ? 'есть' : 'пусто' %></span></div>
            <div style="font-size:12px; color:var(--text-faint); margin-top:4px;">Summ: <%= u.memoryStats.summaries %> · Facts: <%= u.memoryStats.facts %></div>
            <div style="margin-top:6px; display:flex; gap:6px; flex-wrap:wrap;">
              <a href="/admin/memory/<%= u.id %>" class="btn btn-sm btn-secondary">Открыть память</a>
              <form method="post" action="/admin/users/<%= u.id %>/memory/rebuild" style="margin:0;">
                <input type="hidden" name="redirectTo" value="/admin/users" />
                <button type="submit" class="btn btn-sm btn-primary" data-confirm="Пересобрать память этого пользователя по всем сессиям?">Обновить память</button>
              </form>
            </div>
          </td>
          <td style="color:var(--text-faint); font-size:12px"><%= u.createdAt.toISOString().split('T')[0] %></td>
        </tr>
      <% }) %>
      </tbody>
    </table>
  </div>
</div>

<%- include('partials/footer') %>
