<%- include('partials/header', { title: 'Настройки памяти' }) %>

<div class="admin-page-head">
  <div>
    <div style="display:flex;gap:8px;flex-wrap:wrap;margin-bottom:8px;">
      <span class="badge badge-accent">Memory</span>
      <span class="badge badge-muted">Pipeline</span>
      <span class="badge badge-muted">Scribe</span>
    </div>
    <p class="meta">Точная настройка memory-пайплайна Alma в едином формате админ-дашборда.</p>
    <p class="hint">
      Режим максимальной точности: сжатие и извлечение могут запускаться на каждом сообщении.
      Фильтры мусорных реплик настраиваются в разделе
      <a href="/admin/memory-filters" class="table-link">Фильтры памяти</a>.
    </p>
  </div>
</div>

<div class="card admin-card">
  <form method="post" action="/admin/memory-settings" class="admin-form">
    <div class="admin-section">
      <h3 class="admin-section-title">Базовые параметры</h3>
      <label class="checkbox-row">
        <input class="form-input" type="checkbox" name="enabled" value="true" <%= memorySettings.enabled ? 'checked' : '' %> />
        Включить систему памяти
      </label>
      <div class="form-group">
        <label class="form-label">Модель для памяти (Scribe)</label>
        <select class="form-select" name="scribeModel">
          <% (memoryModelOptions || [{ modelId: 'openrouter/auto', name: 'OpenRouter Auto' }]).forEach((item) => { %>
            <option value="<%= item.modelId %>" <%= (memorySettings.scribeModel || 'openrouter/auto') === item.modelId ? 'selected' : '' %>>
              <%= item.name || item.modelId %>
            </option>
          <% }) %>
        </select>
      </div>
      <p class="hint">Показаны рабочие модели из раздела теста моделей. Эта модель используется для обновления памяти.</p>
    </div>

    <div class="admin-section">
      <h3 class="admin-section-title">Интервалы и окна</h3>
      <div class="admin-form-grid">
        <div class="form-group">
          <label class="form-label">Сжимать сессию в SessionSummary каждые N сообщений</label>
          <input class="form-input" type="number" min="1" max="300" name="summarizeEveryMessages" value="<%= memorySettings.summarizeEveryMessages %>" />
        </div>
        <div class="form-group">
          <label class="form-label">Извлекать факты пользователя каждые N сообщений</label>
          <input class="form-input" type="number" min="1" max="300" name="extractFactsEveryMessages" value="<%= memorySettings.extractFactsEveryMessages %>" />
        </div>
        <div class="form-group">
          <label class="form-label">Обновлять профиль памяти каждые N сообщений</label>
          <input class="form-input" type="number" min="1" max="500" name="updateProfileEveryMessages" value="<%= memorySettings.updateProfileEveryMessages %>" />
        </div>
        <div class="form-group">
          <label class="form-label">Сколько последних сообщений брать для извлечения фактов</label>
          <input class="form-input" type="number" min="10" max="150" name="factsWindowMessages" value="<%= memorySettings.factsWindowMessages %>" />
        </div>
        <div class="form-group">
          <label class="form-label">Сколько последних сообщений чата брать в текущий контекст модели</label>
          <input class="form-input" type="number" min="8" max="60" name="promptHistoryMessages" value="<%= memorySettings.promptHistoryMessages %>" />
        </div>
      </div>
    </div>

    <div class="admin-section">
      <h3 class="admin-section-title">Лимиты контекста</h3>
      <div class="admin-form-grid">
        <div class="form-group">
          <label class="form-label">Лимит слов для профиля памяти в системном промпте</label>
          <input class="form-input" type="number" min="80" max="500" name="maxProfileWords" value="<%= memorySettings.maxProfileWords %>" />
        </div>
        <div class="form-group">
          <label class="form-label">Лимит слов для последних сессионных сводок в системном промпте</label>
          <input class="form-input" type="number" min="120" max="800" name="maxSummaryWords" value="<%= memorySettings.maxSummaryWords %>" />
        </div>
        <div class="form-group">
          <label class="form-label">Максимум фактов, которые попадут в системный промпт</label>
          <input class="form-input" type="number" min="5" max="100" name="maxPendingFacts" value="<%= memorySettings.maxPendingFacts %>" />
        </div>
      </div>
      <label class="checkbox-row">
        <input class="form-input" type="checkbox" name="runOnRegenerate" value="true" <%= memorySettings.runOnRegenerate ? 'checked' : '' %> />
        Запускать memory-пайплайн после перегенерации ответа
      </label>
    </div>

    <div class="admin-actions">
      <button type="submit" class="btn btn-primary">Сохранить настройки памяти</button>
    </div>
  </form>
</div>

<%- include('partials/footer') %>
