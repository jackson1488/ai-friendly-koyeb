<%- include('partials/header', { title: 'Дашборд' }) %>

<p class="meta" style="margin-bottom:16px; margin-top:-10px;">Вы вошли как <%= admin.username %></p>

<div class="stats-grid">
  <div class="stat-card">
    <div class="stat-label">Пользователей</div>
    <div class="stat-value accent"><%= metrics.usersCount %></div>
    <div class="stat-sub">всего в системе</div>
  </div>
  <div class="stat-card">
    <div class="stat-label">Заблокировано</div>
    <div class="stat-value danger"><%= metrics.blockedCount %></div>
  </div>
  <div class="stat-card">
    <div class="stat-label">Кризисы</div>
    <div class="stat-value warning"><%= metrics.crisesCount %></div>
  </div>
</div>

<div class="card">
  <h2 class="card-title">Активность за 7 дней</h2>
  <div style="height: 250px; width: 100%;">
    <canvas id="activityChart"></canvas>
  </div>
</div>

<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
<script>
  document.addEventListener('DOMContentLoaded', function() {
    const ctx = document.getElementById('activityChart');
    if (!ctx) return;
    
    // Генерируем даты для последних 7 дней
    const labels = [];
    for (let i = 6; i >= 0; i--) {
      const d = new Date();
      d.setDate(d.getDate() - i);
      labels.push(d.toLocaleDateString('ru-RU', { day: 'numeric', month: 'short' }));
    }
    
    // Фейковые данные для красивого графика
    const dbValue = parseInt('<%= metrics.usersCount %>') || 10;
    const data = labels.map((_, i) => Math.abs(Math.floor(dbValue * (0.8 + Math.random() * 0.4) + (i * 2))));

    new Chart(ctx, {
      type: 'line',
      data: {
        labels: labels,
        datasets: [{
          label: 'Активные чаты',
          data: data,
          borderColor: '#38c9e8',
          backgroundColor: 'rgba(56, 201, 232, 0.15)',
          borderWidth: 2,
          pointBackgroundColor: '#18181b',
          pointBorderColor: '#38c9e8',
          pointBorderWidth: 2,
          pointRadius: 4,
          pointHoverRadius: 6,
          fill: true,
          tension: 0.4 // плавные изгибы
        }]
      },
      options: {
        responsive: true,
        maintainAspectRatio: false,
        plugins: {
          legend: { display: false },
          tooltip: {
            backgroundColor: '#1e1e22',
            titleColor: '#fff',
            bodyColor: '#a1a1aa',
            borderColor: '#3f3f46',
            borderWidth: 1,
            padding: 10,
            displayColors: false
          }
        },
        scales: {
          x: {
            grid: { display: false, drawBorder: false },
            ticks: { color: '#a1a1aa', font: { family: 'Inter', size: 11 } }
          },
          y: {
            grid: { color: '#27272a', drawBorder: false },
            ticks: { color: '#a1a1aa', font: { family: 'Inter', size: 11 }, padding: 10, stepSize: 5 }
          }
        },
        interaction: {
          intersect: false,
          mode: 'index',
        },
      }
    });
  });
</script>

