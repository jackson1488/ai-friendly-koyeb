    </a>
  </div>
</div>

<div class="card">
  <h2 class="card-title">Новые пользователи</h2>
  <div class="table-wrapper">
    <table>
      <thead><tr>
        <th>Пользователь</th>
        <th>Имя</th>
        <th>Дата создания</th>
      </tr></thead>
      <tbody>
      <% latestUsers.forEach((u) => { %>
        <tr>
          <td><a href="/admin/users/<%= u.id %>" class="table-link"><%= u.username %></a></td>
          <td><%= u.displayName %></td>
          <td style="color:var(--text-faint)"><%= u.createdAt.toISOString() %></td>
        </tr>
      <% }) %>
      </tbody>
    </table>
  </div>
</div>

<div class="card">
  <h2 class="card-title">Последние кризисные события</h2>
  <div class="table-wrapper">
    <table>
      <thead><tr>
        <th>Пользователь</th>
        <th>Тип</th>
        <th>Время</th>
      </tr></thead>
      <tbody>
      <% latestCrises.forEach((c) => { %>
        <tr>
          <td><%= c.user ? c.user.username : 'удален' %></td>
          <td><span class="badge badge-warning"><%= c.triggerType %></span></td>
          <td style="color:var(--text-faint)"><%= c.createdAt.toISOString() %></td>
        </tr>
      <% }) %>
      </tbody>
    </table>
  </div>
</div>

<%- include('partials/footer') %>
