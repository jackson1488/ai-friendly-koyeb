<%- include('partials/header', { title: 'PRO chats' }) %>

<a href="/admin/users/<%= user.id %>" class="back-link">
  <svg width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M10 19l-7-7m0 0l7-7m-7 7h18"></path></svg>
  Back to user card
</a>

<div class="card">
  <div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:16px;">
    <h2 class="card-title" style="margin:0;">PRO chats: <%= user.username %></h2>
  </div>
  <div class="table-wrapper">
    <table>
      <thead>
        <tr>
          <th>Title</th>
          <th>Status</th>
          <th>Messages</th>
          <th>Created</th>
          <th>Updated</th>
          <th>Actions</th>
        </tr>
      </thead>
      <tbody>
        <% if (!proChats || proChats.length === 0) { %>
          <tr><td colspan="6" style="text-align:center; padding:24px; color:var(--text-faint)">No PRO chats yet.</td></tr>
        <% } else { %>
          <% proChats.forEach((c) => { %>
            <tr>
              <td>
                <a href="/admin/users/<%= user.id %>/pro-chats/<%= encodeURIComponent(c.clientChatId) %>" class="table-link" style="font-weight:600;">
                  <%= c.title || 'New PRO chat' %>
                </a>
                <div style="font-size:12px; color:var(--text-faint); margin-top:4px;"><code><%= c.clientChatId %></code></div>
              </td>
              <td>
                <% if (c.isDeleted) { %>
                  <span class="badge badge-warning">Deleted by user</span>
                  <div style="font-size:12px; color:var(--text-faint); margin-top:4px;"><%= c.deletedReason || 'deleted_by_user' %></div>
                <% } else { %>
                  <span class="badge badge-success">Active</span>
                <% } %>
              </td>
              <td style="color:var(--text-faint); font-size:12px;"><%= c.messageCount || 0 %></td>
              <td style="color:var(--text-faint); font-size:12px;"><%= c.createdAt ? c.createdAt.toISOString().slice(0,16).replace('T', ' ') : '—' %></td>
              <td style="color:var(--text-faint); font-size:12px;"><%= c.updatedAt ? c.updatedAt.toISOString().slice(0,16).replace('T', ' ') : '—' %></td>
              <td>
                <% if (c.isDeleted) { %>
                  <form method="post" action="/admin/users/<%= user.id %>/pro-chats/<%= encodeURIComponent(c.clientChatId) %>/restore" style="margin:0;">
                    <button type="submit" class="btn btn-sm btn-secondary">Restore</button>
                  </form>
                <% } else { %>
                  <span style="color:var(--text-faint); font-size:12px;">—</span>
                <% } %>
              </td>
            </tr>
          <% }) %>
        <% } %>
      </tbody>
    </table>
  </div>
</div>

<%- include('partials/footer') %>
