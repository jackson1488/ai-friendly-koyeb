{
  "name": "ai-mental-backend",
  "version": "1.0.0",
  "private": true,
  "type": "commonjs",
  "scripts": {
    "predev": "prisma generate",
    "dev": "node --watch src/server.js",
    "prestart": "prisma generate",
    "start": "node src/server.js",
    "postinstall": "prisma generate",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "users:migrate:numeric-id": "node src/scripts/migrateUserIdsToNumeric.js",
    "users:backfill:public-id": "node src/scripts/backfillPublicIds.js",
    "session-summaries:cleanup": "node src/scripts/cleanupSessionSummaries.js",
    "session-summaries:cleanup:dry": "node src/scripts/cleanupSessionSummaries.js --dry-run",
    "start:koyeb": "node src/scripts/prepareKoyebRuntime.js && prisma migrate deploy && node src/server.js",
    "migrate:deploy": "prisma migrate deploy",
    "prepare:koyeb-runtime": "node src/scripts/prepareKoyebRuntime.js"
  },
  "dependencies": {
    "@prisma/client": "6.3.1",
    "bcryptjs": "^2.4.3",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "ejs": "^3.1.10",
    "express": "^4.21.2",
    "express-rate-limit": "^7.5.0",
    "helmet": "^8.0.0",
    "jsonwebtoken": "^9.0.2",
    "morgan": "^1.10.0",
    "multer": "^2.1.1",
    "node-cron": "^4.2.1",
    "socket.io": "^4.8.1",
    "ws": "^8.18.3",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "prisma": "6.3.1"
  }
}
